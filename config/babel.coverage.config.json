{
  "presets": [
    "@babel/preset-typescript",
    "@babel/preset-env"
  ],
  "plugins": [
    [
      "babel-plugin-prefix-private-members",
      {
        "aliases": {
          "treeElement/": "./src/"
        },
        "prefixParameterKeys": true,
        "prefixPublicMembers": true,
        "excludeClasses": [
          "Node",
          "TreeElement"
        ]
      }
    ],
    "istanbul"
  ],
  "targets": "defaults"
}
