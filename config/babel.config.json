{
  "presets": ["@babel/preset-typescript", "@babel/preset-env"],
  "plugins": [
    [
      "babel-plugin-prefix-private-members",
      {
        "aliases": { "treeElement/": "./src/" },
        "prefixParameterKeys": true,
        "prefixPublicMembers": true,
        "excludeClasses": ["Node", "TreeElement"]
      }
    ],
    [
      "./babelPluginMinifySyntax.mjs",
      { "excludeClasses": ["Node", "TreeElement"] }
    ]
  ],
  "env": {
    "test": {
      "presets": ["@babel/preset-typescript", "@babel/preset-env"]
    }
  },
  "targets": "defaults"
}
