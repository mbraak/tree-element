/*
  Colors. Override them on :root or on an element around the tree, for example
  for a dark theme. :where keeps the specificity at 0, so any rule wins.
  --tree-element-selected-color defaults to --tree-element-title-color.
*/
:where(:root) {
  --tree-element-title-color: #1c4257;
  --tree-element-toggler-color: #333;
  --tree-element-toggler-hover-color: #000;
  --tree-element-selected-background: linear-gradient(#bee0f5, #89afca);
  --tree-element-selected-text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
  --tree-element-drop-hint-color: #00f;
  --tree-element-dragging-color: #fff;
  --tree-element-dragging-background: #000;
}

ul.tree-element {
  list-style: none outside;
  margin-left: 0;
  margin-bottom: 0;
  padding: 0;

  &.tree-element-dnd {
    touch-action: none;
  }

  ul.tree-element-common {
    list-style: none outside;
    margin-left: 12px;
    margin-right: 0;
    margin-bottom: 0;
    padding: 0;
    display: block;
  }

  li.tree-element-closed > ul.tree-element-common {
    display: none;
  }

  li.tree-element-common {
    clear: both;
    list-style-type: none;
  }

  .tree-element-toggler {
    border-bottom: none;
    color: var(--tree-element-toggler-color);
    text-decoration: none;
    vertical-align: middle;

    &:hover {
      color: var(--tree-element-toggler-hover-color);
      text-decoration: none;
    }

    &.tree-element-closed {
      background-position: 0 0;
    }

    &.tree-element-toggler-left {
      margin-right: 0.5em;
    }

    &.tree-element-toggler-right {
      margin-left: 0.5em;
    }
  }

  .tree-element-element {
    cursor: pointer;
    position: relative;
    display: flex;

    &:has(.tree-element-title-button-right) {
      display: block;
    }
  }

  .tree-element-title {
    color: var(--tree-element-title-color);
    vertical-align: middle;
  }

  .tree-element-title-button-left {
    margin-left: 1.5em;

    &.tree-element-title-folder {
      margin-left: 0;
    }
  }

  li.tree-element-folder {
    margin-bottom: 4px;

    &.tree-element-closed {
      margin-bottom: 1px;
    }
  }

  li.tree-element-ghost {
    position: relative;
    z-index: 10;
    margin-right: 10px;

    span {
      display: block;
    }

    span.tree-element-circle {
      border: solid 2px var(--tree-element-drop-hint-color);
      border-radius: 100px;
      height: 8px;
      width: 8px;
      position: absolute;
      top: -4px;
      left: -6px;
      box-sizing: border-box;
    }

    span.tree-element-line {
      background-color: var(--tree-element-drop-hint-color);
      height: 2px;
      padding: 0;
      position: absolute;
      top: -1px;
      left: 2px;
      width: 100%;
    }

    &.tree-element-inside {
      margin-left: 48px;
    }
  }

  span.tree-element-border {
    position: absolute;
    display: block;
    left: -2px;
    top: 0;
    border: solid 2px var(--tree-element-drop-hint-color);
    border-radius: 6px;
    margin: 0;
    box-sizing: content-box;
  }

  li.tree-element-selected > .tree-element-element,
  li.tree-element-selected > .tree-element-element:hover {
    background: var(--tree-element-selected-background);
    text-shadow: var(--tree-element-selected-text-shadow);
  }

  li.tree-element-selected > .tree-element-element .tree-element-title {
    color: var(--tree-element-selected-color, var(--tree-element-title-color));
  }

  .tree-element-moving > .tree-element-element .tree-element-title {
    outline: dashed 1px var(--tree-element-drop-hint-color);
  }
}

ul.tree-element.tree-element-rtl {
  direction: rtl;

  ul.tree-element-common {
    margin-left: 0;
    margin-right: 12px;
  }

  .tree-element-toggler {
    margin-left: 0.5em;
    margin-right: 0;
  }

  .tree-element-title {
    margin-left: 0;
    margin-right: 1.5em;

    &.tree-element-title-folder {
      margin-right: 0;
    }
  }

  li.tree-element-ghost {
    margin-right: 0;
    margin-left: 10px;

    span.tree-element-circle {
      right: -6px;
    }

    span.tree-element-line {
      right: 2px;
    }

    &.tree-element-inside {
      margin-left: 0;
      margin-right: 48px;
    }
  }

  span.tree-element-border {
    right: -2px;
  }
}

span.tree-element-dragging {
  color: var(--tree-element-dragging-color);
  background: var(--tree-element-dragging-background);
  opacity: 0.6;
  cursor: pointer;
  padding: 2px 8px;
}
